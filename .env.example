# ============================================
# WhatsApp Anti-Ban Middleware - Configuration
# ============================================

# --- Evolution API ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=sua-chave-api-aqui

# --- Redis (usado para filas e cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MongoDB (usado pelo Evolution API) ---
MONGO_URI=mongodb://mongodb:27017/evolution

# --- Middleware Server ---
MIDDLEWARE_PORT=3100
MIDDLEWARE_API_KEY=sua-chave-middleware-aqui

# --- Proxy Residencial ---
# Providers suportados: smartproxy, brightdata, oxylabs, custom
PROXY_PROVIDER=custom
# Para SmartProxy:
PROXY_SMARTPROXY_USER=
PROXY_SMARTPROXY_PASS=
# Para BrightData:
PROXY_BRIGHTDATA_USER=
PROXY_BRIGHTDATA_PASS=
PROXY_BRIGHTDATA_ZONE=
# Para proxy custom (seu próprio):
PROXY_CUSTOM_HOST=
PROXY_CUSTOM_PORT=
PROXY_CUSTOM_USER=
PROXY_CUSTOM_PASS=
PROXY_CUSTOM_PROTOCOL=http

# --- Anti-Ban Config ---
# Delay entre mensagens (ms) - min e max para distribuicao gaussiana
ANTIBAN_DELAY_MIN=3000
ANTIBAN_DELAY_MAX=12000
# Delay entre lotes de mensagens (ms)
ANTIBAN_BATCH_DELAY_MIN=30000
ANTIBAN_BATCH_DELAY_MAX=120000
# Tamanho maximo do lote antes de pausar
ANTIBAN_BATCH_SIZE=10
# Periodo de warm-up para novas instancias (horas)
ANTIBAN_WARMUP_HOURS=48
# Maximo de mensagens por instancia por dia durante warm-up
ANTIBAN_WARMUP_DAILY_LIMIT=20
# Maximo de mensagens por instancia por dia apos warm-up
ANTIBAN_DAILY_LIMIT=200
# Horario de envio permitido (formato 24h)
ANTIBAN_SEND_HOUR_START=8
ANTIBAN_SEND_HOUR_END=21

# --- N8N Webhook ---
N8N_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp
N8N_WEBHOOK_SECRET=
